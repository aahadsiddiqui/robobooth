# Twilio Verify — Phone verification for all website forms
# Copy this file to .env.local and fill in your values.

# 1. TWILIO_ACCOUNT_SID
#    Where: https://console.twilio.com → Account Info (dashboard home)
#    Looks like: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TWILIO_ACCOUNT_SID=your_account_sid_here

# 2. TWILIO_AUTH_TOKEN
#    Where: Same page as Account SID → click "Show" to reveal
#    Keep this secret — never commit to git or expose in frontend code

TWILIO_AUTH_TOKEN=your_auth_token_here

# 3. TWILIO_VERIFY_SERVICE_SID
#    Where: https://console.twilio.com/us1/develop/verify/services
#    → Create a new Verify Service (name it e.g. "RoboBooth Website")
#    → Copy the Service SID (starts with VA)
#    Looks like: VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# ── Setup checklist ──
# 1. Create a free Twilio account at https://www.twilio.com/try-twilio
# 2. Verify your email and complete account setup
# 3. Copy Account SID + Auth Token from the console dashboard
# 4. Go to Verify → Services → Create new service
# 5. Add all 3 values above to .env.local in the project root
# 6. Restart your dev server: npm run dev
#
# Note: Trial accounts can only send SMS to verified phone numbers.
# Add test numbers at: Phone Numbers → Verified Caller IDs
